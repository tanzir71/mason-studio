{
  "color": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.1647, 0.1333], "hex": "#1e2a22" } },
    "cream": { "$value": "#f3eee4" },
    "rust": { "$value": "#b4532a" },
    "muted": { "$value": "#4a544c" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] }
  },
  "space": {
    "$type": "dimension",
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": "32px" }
  },
  "type": {
    "display": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": { "dev.mason.breakpoints": { "tablet": "32px", "mobile": "28px" } }
    }
  }
}
